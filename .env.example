# ============================================================
# MediCAB Environment Variables Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# Database Engine Selection:
# Set USE_SQLITE=1 for zero-config local development (No MySQL installation required).
# Set USE_SQLITE=0 to use MySQL (Required in Docker Compose and Production).
USE_SQLITE=1

# Django Backend Settings
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# MySQL Database Settings (when USE_SQLITE=0)
DB_NAME=medicab_db
DB_USER=medicab_user
DB_PASSWORD=medicab_pass
DB_ROOT_PASSWORD=rootpassword
DB_HOST=127.0.0.1
DB_PORT=3306
